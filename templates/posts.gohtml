<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Posts</title>
</head>

<body>
  <ul>
    {{range $index, $element := .Posts}}
    <li>{{$element}}</li>
    {{else}}
    <li>No Posts </li>
    {{end}}
  </ul>
</body>

</html>
