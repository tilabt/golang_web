<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{.Title}}</title>
</head>

<body>
  <h1>My Name: {{.Name}}</h1>
  <h2>Age {{.Age}}</h2>
  <h3> Address: </h3>
  <ul>
    {{with .Address}}
    <li>{{.Country}}</li>
    <li>{{.Street}}</li>
    <li>{{.No}}</li>
    {{else}}
    <li>no address </li>
    {{end}}
  </ul>
  <!--<h4>should be hidden h4<h4>-->
  {{/*<h4>should be hidden<h4>*/}}
</body>

</html>
